				pinctrl-2 = <0x00>;
				pinctrl-3 = <0x00>;
				pinctrl-4 = <0x00>;
				pinctrl-5 = <0x00>;
				pinctrl-6 = <0x00>;
			};
		};

		fragment@32 {

			__overlay__ {

				secured-reserved {
					memory-region = <0x00>;
				};

				fd-reserved {
					memory-region = <0x00>;
				};

				protected-reserved {
					memory-region = <0x00>;
				};
			};
		};
	};
};
