				sprd,ctrl-reg = <0x9018 0x23a8 0x2818 0x23a8 0x90 0xc8 0x0c 0x1404 0x50 0x0c>;
				sprd,ctrl-mask = <0x3fff 0x2000000 0x80 0x1000000 0x40000000 0x100f 0x22 0x1ffffff 0xffffffff 0x22>;
				sprd,ctrl-value = <0x70 0x2000000 0x80 0x1000000 0x40000000 0x00 0x22 0x1600000 0x1ffc00 0x00>;
				sprd,ctrl-rw-offset = <0x1000 0x2000 0x2000 0x2000 0x00 0x00 0x00 0x1000 0x00 0x00>;
				sprd,ctrl-us-delay = <0x3e8 0x3e8 0x3e8 0x7d0 0x3e8 0x3e8 0x3e8 0x3e8 0x3e8 0x3e8>;
				sprd,ctrl-type = <0x02 0x01 0x01 0x01 0x0a 0x0a 0x09 0x08 0x09 0x09>;
				sprd,ctrl-shutdown-reg = <0xc8>;
				sprd,ctrl-shutdown-mask = <0x1000>;
				sprd,ctrl-shutdown-value = <0x1000>;
				sprd,ctrl-shutdown-rw-offset = <0x00>;
				sprd,ctrl-shutdown-us-delay = <0x0a>;
				sprd,ctrl-shutdown-type = <0x0a>;
				reg = <0x00 0x87600000 0x00 0x180000>;
				sprd,file-name = "/dev/block/platform/soc/soc:ap-apb/201d0000.sdio/by-name/gnssmodem";
				sprd,file-name-ext = "/dev/block/platform/soc/soc:ap-apb/201d0000.sdio/by-name/gnssmodem";
				sprd,file-name-ufs = "/dev/block/platform/soc/soc:ap-apb/20200000.ufs/by-name/gnssmodem";
				sprd,file-name-ext-ufs = "/dev/block/platform/soc/soc:ap-apb/20200000.ufs/by-name/gnssmodem";
				sprd,file-length = <0x180000>;
				sprd,rstpad-setting = <0x01>;
				sprd,apcp-sync-addr = <0x1ffc00>;
				sprd,wcn-sipc-ver = <0x01>;
				vddwcn-supply = <&vddwcn>;
				dcxo1v8-supply = <&vddsim2>;
				merlion-chip-en-gpios = <&ap_gpio>, <0x76 0x00>;
				merlion-rst-gpios = <&ap_gpio>, <0x75 0x00>;
				#address-cells = <0x01>;
				#size-cells = <0x01>;
				nvmem-cells = <&wcn_alpha>;
				nvmem-cell-names = "gnss_efuse_blk0";
				phandle = <0x3a>;

				wcn-dump {

					gnss-dump {
						sprd,aon-control = <0x40c00000 0x64 0x11000000 0x00>;
						sprd,aon-ahb-sys = <0x40b18000 0x42c 0x11000000 0x00>;
						sprd,aon-apb-peri = <0x40bc8000 0x2e4 0x11000000 0x00>;
						sprd,aon-wcn-gnss-clk = <0x40bd8000 0x54 0x11000000 0x00>;
						sprd,gnss-iram-pchannel = <0x40e40000 0x20000 0x11000000 0x00>;
						sprd,gnss-iram = <0x40a50000 0x8000 0x11000000 0x00>;
						sprd,gnss-sipc-buff = <0x88240000 0x40000 0x00 0x00>;
						sprd,gnss-share-mem = <0x00 0x200000 0x87600000 0x00>;
					};
				};
			};

			gnss_common_ctl {
				compatible = "sprd,gnss";
				sprd,name = "gnss_common_ctl";
			};

			pwm_backlight: sprd_backlight {
				compatible = "sprd,sharkl6-backlight";
				pwms = <&pwms>, <0x02 0x9c40>;
				pwm-names = "backlight";
				sprd,max-brightness-level = <0x39c>;
				default-brightness-level = <0x106>;
				sprd,brightness-scale = <0x3ff>;
				brightness-levels = <0x00 0x03 0x04 0x05 0x06 0x07 0x08 0x09 0x0a 0x0b 0x0c 0x0d 0x0e 0x10 0x11 0x12 0x13 0x14 0x15 0x16 0x17 0x18 0x19 0x1a 0x1b 0x1c 0x1d 0x1f 0x21 0x23 0x25 0x27 0x29 0x2b 0x2d 0x2f 0x30 0x32 0x34 0x36 0x38 0x3a 0x3c 0x3e 0x40 0x43 0x45 0x48 0x4a 0x4c 0x4e 0x50 0x52 0x54 0x56 0x58 0x5a 0x5c 0x5e 0x60 0x62 0x64 0x66 0x68 0x6b 0x6d 0x70 0x72 0x74 0x76 0x78 0x7a 0x7c 0x7e 0x80 0x82 0x84 0x86 0x88 0x8a 0x8c 0x8e 0x90 0x93 0x95 0x97 0x9a 0x9c 0x9e 0xa0 0xa2 0xa4 0xa6 0xa8 0xaa 0xac 0xaf 0xb2 0xb5 0xb8 0xbb 0xbe 0xc1 0xc4 0xc7 0xcb 0xcd 0xd0 0xd3 0xd6 0xd9 0xdc 0xdf 0xe2 0xe5 0xea 0xed 0xf0 0xf3 0xf7 0xfa 0xfd 0x100 0x103 0x107 0x10a 0x10d 0x10e 0x112 0x115 0x118 0x11b 0x11f 0x122 0x126 0x129 0x12c 0x12f 0x133 0x136 0x13a 0x13e 0x145 0x149 0x14e 0x153 0x154 0x157 0x15b 0x15e 0x162 0x166 0x16d 0x171 0x176 0x17c 0x17e 0x181 0x185 0x188 0x18c 0x190 0x197 0x19b 0x1a0 0x1a6 0x1aa 0x1ae 0x1b2 0x1b6 0x1ba 0x1be 0x1c4 0x1c9 0x1cc 0x1d0 0x1d6 0x1da 0x1e0 0x1e6 0x1ec 0x1f2 0x1f8 0x1fc 0x200 0x204 0x20a 0x20f 0x214 0x218 0x21c 0x221 0x226 0x22b 0x231 0x238 0x23e 0x243 0x248 0x24d 0x252 0x258 0x25d 0x262 0x267 0x26c 0x271 0x276 0x27b 0x281 0x287 0x28c 0x291 0x296 0x29b 0x2a1 0x2b0 0x2b6 0x2bc 0x2c2 0x2c8 0x2cc 0x2d0 0x2d5 0x2da 0x2df 0x2e4 0x2ea 0x2f0 0x2f6 0x2fc 0x302 0x308 0x30e 0x316 0x31e 0x323 0x32a 0x331 0x339 0x340 0x348 0x34d 0x352 0x357 0x35d 0x362 0x368 0x36e 0x374 0x37a 0x380 0x387 0x38f 0x396 0x39c>;
				phandle = <0x1f>;
			};

			skin_sensor: skin-sensor {
				compatible = "sprd,virt-thm";
				#thermal-sensor-cells = <0x00>;
				thmzone-cells = <&bd_thmzone>;
				phandle = <0x1c>;
			};

			fingerprint@0 {
				compatible = "microarray,afs121";
				fpint-gpios = <&eic_async>, <0x1d 0x00>;
			};

			gpio-keys {
				compatible = "gpio-keys";

				key-volumedown {
					label = "Volume Down Key";
					linux,code = <0x72>;
					gpios = <&ap_gpio>, <0x7c 0x01>;
					debounce-interval = <0x02>;
					wakeup-source;
				};

				key-volumeup {
					label = "Volume Up Key";
					linux,code = <0x73>;
					gpios = <&pmic_eic>, <0x04 0x00>;
					debounce-interval = <0x02>;
					wakeup-source;
				};

				key-power {
					label = "Power Key";
					linux,code = <0x74>;
					gpios = <&pmic_eic>, <0x01 0x01>;
					debounce-interval = <0x02>;
					wakeup-source;
				};
			};

			audio-voice-trig {
				status = "disable";
				compatible = "sprd,voice_trig";
				irq_gpio = <&ap_gpio>, <0xa9 0x00>;
			};

			sprd-uid {
				compatible = "sprd,uid";
				nvmem-cells = <&uid_start>, <&uid_end>;
				nvmem-cell-names = "uid_start", "uid_end";
			};
		};
	};

	fragment@0 {
		target = <&spi3>;

		__overlay__ {
			status = "okay";
			#address-cells = <0x01>;
			#size-cells = <0x00>;

			omnivision_tcm@0 {
				compatible = "omnivision_tcm-modules", "chipone-tddi-modules", "himax_mmi-modules", "focaltech,fts-modules", "jadard,jdcommon-modules";
				reg = <0x00>;
				spi-max-frequency = <0x927c00>;
				panel = <&lcd_td4160_cw_old_mipi_hd>, <&lcd_td4160_cw_new_mipi_hd>, <&lcd_td4160_cw_mipi_hd>, <&lcd_hx83108a_lce_mipi_hd>, <&lcd_hx83108a_boe_mipi_hd>, <&lcd_ft8057_ld_mipi_hd>, <&lcd_icnl9916c_ld_hjc_mipi_hd>, <&lcd_icnl9916c_inx_mipi_hd>, <&lcd_icnl9916c_hjc_cd_mipi_hd>, <&lcd_td4160b_cw_boe_mipi_hd>, <&lcd_ft8057p_ld_mipi_hd>;
				omnivision,irq-gpio = <&ap_gpio>, <0x90 0x2008>;
				omnivision,irq-on-state = <0x00>;
				omnivision,reset-gpio = <&ap_gpio>, <0x92 0x00>;
				omnivision,reset-on-state = <0x00>;
				omnivision,reset-active-ms = <0x14>;
				omnivision,reset-delay-ms = <0xc8>;
				omnivision,power-delay-ms = <0xc8>;
				omnivision,spi-mode = <0x03>;
				omnivision,byte-delay-us = <0x00>;
				omnivision,block-delay-us = <0x00>;
				omnivision,ubl-max-freq = <0x2dc6c0>;
				omnivision,ubl-byte-delay-us = <0x14>;
				spi-cpha;
				himax,panel-coords = <0x00 0x2d0 0x00 0x640>;
				himax,display-coords = <0x00 0x2d0 0x00 0x640>;
				himax,irq-gpio = <&ap_gpio>, <0x90 0x2008>;
				himax,rst-gpio = <&ap_gpio>, <0x92 0x00>;
				report_type = <0x01>;
				focaltech,reset-gpio = <&ap_gpio>, <0x92 0x00>;
				focaltech,irq-gpio = <&ap_gpio>, <0x90 0x2008>;
				focaltech,max-touch-number = <0x0a>;
				focaltech,display-coords = <0x00 0x00 0x2cf 0x63f>;
				chipone,rst-gpio = <&ap_gpio>, <0x92 0x00>;
				chipone,irq-gpio = <&ap_gpio>, <0x90 0x2008>;
				chipone,x-res = <0x2d0>;
				chipone,y-res = <0x640>;
				chipone,touch-charger-detect-enable;
				chipone,touch-charger-detect-type = "notify";
				chipone,touch-charger-detect-psy-name = "charger";
				chipone,touch-charger-detect-psp = "POWER_SUPPLY_PROP_ONLINE";
				chipone,touch-charger-detect-psp-poll-interval = <0x3e8>;
				chipone,touch-earjack-detect-enable;
				chipone,touch-earjack-state-filepath = "/sys/bus/platform/drivers/Accdet_Driver/state";
				chipone,touch-earjack-poll-interval = <0x3e8>;
				chipone,test-reset-pin;
				chipone,test-int-pin;
				chipone,test-rawdata;
				chipone,test-rawdata-frames = <0x01>;
				chipone,rawdata-min = <0x44c>;
				chipone,rawdata-max = <0xb54>;
				chipone,test-noise;
				chipone,test-noise-frames = <0x32>;
				chipone,noise-max = <0x78>;
				chipone,test-open;
				chipone,open-min = <0x640>;
				chipone,test-short;
				chipone,short-min = <0x640>;
				chipone,test-compensate-cap;
				chipone,compensate-cap-min = <0x01>;
				chipone,compensate-cap-max = <0x7f>;
				chipone,test-gesture-rawdata;
				chipone,test-gesture-rawdata-frames = <0x03>;
				chipone,gesture-rawdata-min = <0x708>;
				chipone,gesture-rawdata-max = <0x1518>;
				chipone,test-gesture-lp-rawdata;
				chipone,test-gesture-lp-rawdata-frames = <0x03>;
				chipone,gesture-lp-rawdata-min = <0x708>;
				chipone,gesture-lp-rawdata-max = <0x1518>;
				chipone,test-gesture-noise;
				chipone,test-gesture-noise-frames = <0x03>;
				chipone,gesture-noise-max = <0x78>;
				chipone,test-gesture-lp-noise;
				chipone,test-gesture-lp-noise-frames = <0x03>;
				chipone,gesture-lp-noise-max = <0x78>;
				jadard,panel-sense-nums = <0x12 0x20>;
				jadard,panel-coords = <0x00 0x2d0 0x00 0x640>;
				jadard,panel-max-points = <0x0a>;
				jadard,int-is-edge = <0x01>;
				jadard,irq-gpio = <&ap_gpio>, <0x90 0x2008>;
				jadard,rst-gpio = <&ap_gpio>, <0x92 0x00>;
			};
		};
	};

	fragment@1 {
		target = <&bat>;

		__overlay__ {
			compatible = "simple-battery";
			status = "okay";
			charge-full-design-microamp-hours = <0x2d0370>;
			charge-full-microamp-hours = <0x2d0370>;
			charge-term-current-microamp = <0xea60>;
			constant-charge-voltage-max-microvolt = <0x423920>;
			factory-internal-resistance-micro-ohms = <0x3d860>;
			voltage-min-design-microvolt = <0x34a490>;
			fast-charge-threshold-microvolt = <0x3e8fa0>;
			fullbatt-voltage = <0x419ce0>;
			fullbatt-current = <0x1d4c0>;
			first-fullbatt-current = <0x249f0>;
			fullbatt-track-end-vol = <0x418958>;
			fullbatt-track-end-cur = <0x1fbd0>;
			first-calib-voltage = <0x36a060>;
			first-calib-capacity = <0x32>;
			ir-cv-offset-microvolt = <0x186a0>;
			ir-rc-micro-ohms = <0x4e20>;
			ir-us-upper-limit-microvolt = <0x44aa20>;
			ocv-capacity-celsius = <0x14>;
			ocv-capacity-table-0 = <0x41cfa8 0x64 0x40e930 0x5f 0x401a28 0x5a 0x3f56d8 0x55 0x3e9770 0x50 0x3df360 0x4b 0x3d2070 0x46 0x3c9f88 0x41 0x3bf790 0x3c 0x3b3c10 0x37 0x3ac2f8 0x32 0x3a6d08 0x2d 0x3a22d0 0x28 0x39e838 0x23 0x39b188 0x1e 0x397308 0x19 0x3928d0 0x14 0x38cb10 0x0f 0x385db0 0x0a 0x382ed0 0x05 0x33e140 0x00>;
			voltage-temp-table = <0x10f0fe 0x320 0xf4010 0x352 0xd963e 0x384 0xbfcb6 0x3b6 0xa7e0e 0x3e8 0x920cc 0x41a 0x7e630 0x44c 0x6ce94 0x47e 0x5d99e 0x4b0 0x504f6 0x4e2 0x44cf0 0x514 0x3af48 0x546 0x328b6 0x578 0x2b5ac 0x5aa 0x253aa 0x5dc 0x20058 0x60e 0x1b968 0x640 0x17dfe 0x672>;
			capacity-temp-table = <0x2d 0x64 0x19 0x64 0x0a 0x64 0x00 0x5f 0xfffffff6 0x5a>;
			resistance-temp-table = <0x2d 0x35 0x19 0x64 0x0a 0x18b 0x00 0x237 0xfffffff6 0x319>;
			temp-advance-fullcap-table = <0x32 0x64 0x19 0x64 0x0a 0x64 0x00 0x64 0xfffffff6 0x64 0xffffffec 0x64>;
			charge-sdp-current-microamp = <0x7a120 0x7a120>;
			charge-dcp-current-microamp = <0x1e8480 0x2dc6c0>;
			charge-cdp-current-microamp = <0x16e360 0x16e360>;
			charge-unknown-current-microamp = <0xf4240 0xf4240>;
			charge-fchg-current-microamp = <0x2dc6c0 0x1e8480>;
			charge-flash-current-microamp = <0x4c4b40 0x2932e0>;
			cap-calib-energy-density-ocv-table = <0x331df0 0x39fbc0 0x3f52f0 0x426030>;
			cap-track-energy-density-ocv-table = <0x33e140 0x38cb10>;
			dcp-jeita-temp-table = <0x3e8 0x406 0x00 0x423920 0x47e 0x49c 0xaae60 0x423920 0x5aa 0x58c 0x1e8480 0x423920 0x640 0x622 0xaae60 0x3e8fa0>;
			sdp-jeita-temp-table = <0x3e8 0x406 0x00 0x423920 0x47e 0x49c 0x7a120 0x423920 0x5aa 0x58c 0x7a120 0x423920 0x640 0x622 0x7a120 0x3e8fa0>;
			cdp-jeita-temp-table = <0x3e8 0x406 0x00 0x423920 0x47e 0x49c 0xaae60 0x423920 0x5aa 0x58c 0x16e360 0x423920 0x640 0x622 0xaae60 0x3e8fa0>;
			unknown-jeita-temp-table = <0x3e8 0x406 0x00 0x423920 0x47e 0x49c 0xaae60 0x423920 0x5aa 0x58c 0xf4240 0x423920 0x640 0x622 0xaae60 0x3e8fa0>;
			fchg-jeita-temp-table = <0x3e8 0x406 0x00 0x423920 0x47e 0x49c 0xaae60 0x423920 0x5aa 0x58c 0x319750 0x423920 0x640 0x622 0xaae60 0x3e8fa0>;
			flash-jeita-temp-table = <0x3e8 0x406 0x00 0x423920 0x47e 0x49c 0xf4240 0x423920 0x5aa 0x58c 0x4c4b40 0x423920 0x640 0x622 0xf4240 0x3e8fa0>;
		};
	};

	fragment@2 {
		target = <&cm>;

		__overlay__ {
			compatible = "charger-manager";
			status = "okay";
			cm-name = "battery";
			cm-poll-mode = <0x02>;
			cm-poll-interval = <0x3a98>;
			cm-battery-stat = <0x02>;
			cm-fullbatt-vchkdrop-ms = <0x7530>;
			cm-fullbatt-vchkdrop-volt = <0xea60>;
			cm-fullbatt-capacity = <0x64>;
			cm-cp-taper-current = <0xf4240>;
			cm-chargers = "bq2560x_charger";
			cm-charge-pumps = "bq2597x-standalone";
			cm-fuel-gauge = "sc27xx-fgu";
			cm-battery-cold = <0xc8>;
			cm-battery-cold-in-minus;
			cm-battery-hot = <0x320>;
			cm-battery-temp-diff = <0x64>;
			cm-charging-max = <0x1499700>;
			cm-discharging-max = <0x2932e0>;
			cm-wdt-interval = <0x3c>;
			cm-shutdown-voltage = <0x2f4d60>;
			cm-tickle-time-out = <0x5dc>;
			cm-one-cap-time = <0x1e>;
			cm-thermal-zone = "board-thmzone";
			cm-charge-voltage-max = <0x632ea0>;
			cm-fast-charge-voltage-max = <0xa037a0>;
			cm-flash-charge-voltage-max = <0xb71b00>;
			cm-charge-voltage-drop = <0xaae60>;
			cm-fast-charge-voltage-drop = <0xaae60>;
			cm-flash-charge-voltage-drop = <0xf4240>;
			sprd,support-fchg;
			sprd,support-pd-pps;
			sprd,pd-fixed-max-microwatt = <0x112a880>;
			monitored-battery-0 = <&bat>;
			cm-capacity-track;
			cm-keep-awake;
			phys = <&hsphy>;
			pd-extcon-enable;
			extcon = <&pmic_typec>, <&pmic_pd>;
			use-typec-extcon;
		};
	};

	fragment@3 {
		target = <&i2c5>;

		__overlay__ {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "okay";

			bq2560x_chg: charger@6b {
				compatible = "ti,bq2560x_chg";
				reg = <0x6b>;
				monitored-battery-0 = <&bat>;
				irq-gpio = <&ap_gpio>, <0x73 0x01>;
				use-typec-extcon;
				phandle = <0x3b>;

				vddvbus: otg-vbus {
					regulator-name = "vddvbus";
					phandle = <0x1b>;
				};
			};

			bq2597x_chg: charger@65 {
				compatible = "ti,bq2597x-standalone";
				reg = <0x65>;
				irq-gpio = <&ap_gpio>, <0x7e 0x01>;
				ti,bq2597x,bus-therm-disable = <0x01>;
				ti,bq2597x,regulation-disable = <0x01>;
				ti,bq2597x,bat-ovp-threshold = <0x1130>;
				ti,bq2597x,bat-ovp-alarm-threshold = <0x10f4>;
				ti,bq2597x,bat-ocp-threshold = <0x157c>;
				ti,bq2597x,bat-ocp-alarm-threshold = <0x1388>;
				ti,bq2597x,bus-ovp-threshold = <0x2cec>;
				ti,bq2597x,bus-ovp-alarm-threshold = <0x2904>;
				ti,bq2597x,bus-ocp-threshold = <0xbb8>;
				ti,bq2597x,bus-ocp-alarm-threshold = <0xa8c>;
				ti,bq2597x,bat-ucp-alarm-threshold = <0x3e8>;
				ti,bq2597x,bat-therm-threshold = <0x15>;
				ti,bq2597x,bus-therm-threshold = <0x15>;
				ti,bq2597x,die-therm-threshold = <0xc8>;
				ti,bq2597x,ac-ovp-threshold = <0x0d>;
				ti,bq2597x,sense-resistor-mohm = <0x05>;
				ti,bq2597x,adc-sample-bits = <0x0d>;
				ti,bq2597x,ibat-regulation-threshold = <0x12c>;
				ti,bq2597x,vbat-regulation-threshold = <0x64>;
				ti,bq2597x,vdrop-threshold = <0x190>;
				ti,bq2597x,vdrop-deglitch = <0x1388>;
				ti,bq2597x,ss-timeout = <0x186a0>;
				ti,bq2597x,watchdog-timer = <0x7530>;
				phandle = <0x3c>;
			};
		};
	};

	fragment@4 {
		target = <&pmic_fgu>;

		__overlay__ {
			monitored-battery-0 = <&bat>;
			fgu-cap-remap-table = <0x01 0x02 0x03 0x02 0x03 0x02 0x62 0x63 0x02 0x63 0x64 0x03>;
			sprd,calib-resistance-micro-ohms = <0x12f2>;
			sprd,comp-resistance-mohm = <0x0b>;
			fgu-capacity-track;
			phys = <&hsphy>;
			sprd,relax-counter-threshold = <0x244>;
			sprd,relax-current-threshold = <0x1e>;
